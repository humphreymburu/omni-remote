{
  "name": "omni-remote",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "mobile:android": "cd apps/mobile && npx react-native run-android",
    "mobile:ios": "cd apps/mobile && npx react-native run-ios",
    "mobile:ios:setup": "cd apps/mobile && bash scripts/ios-setup.sh",
    "mobile:ios:pod": "cd apps/mobile/ios && pod install",
    "mobile:start": "cd apps/mobile && npx react-native start",
    "api:dev": "cd apps/api && npx tsx src/server.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.8.2"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=18"
  }
}
