{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/mobile/src",
    "apps/api/src",
    "packages/core/src",
    "packages/protocol-types/src",
    "packages/discovery/src",
    "packages/adapter-roku/src",
    "packages/adapter-lg-webos/src",
    "packages/adapter-samsung-tizen/src",
    "packages/adapter-cast/src",
