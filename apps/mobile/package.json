{
  "name": "@omni-remote/mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:setup": "bash scripts/ios-setup.sh",
    "ios:pod": "cd ios && pod install",
    "ios:clean": "cd ios && rm -rf Pods Podfile.lock OmniRemote.xcworkspace && pod install",
    "ios:device": "react-native run-ios --device",
    "ios:release": "react-native run-ios --configuration Release",
    "start": "react-native start",
    "build:android": "react-native build-android",
    "build:ios": "react-native build-ios",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@omni-remote/core": "*",
    "@omni-remote/discovery": "*",
    "@omni-remote/protocol-types": "*",
    "@omni-remote/adapter-roku": "*",
    "@omni-remote/adapter-lg-webos": "*",
    "@omni-remote/adapter-samsung-tizen": "*",
    "@omni-remote/adapter-cast": "*",
    "@omni-remote/adapter-upnp": "*",
    "react": "^19.2.0",
    "react-native": "^0.86.0",
    "@react-navigation/native": "^7.1.0",
    "@react-navigation/native-stack": "^7.3.0",
    "@react-navigation/bottom-tabs": "^7.3.0",
    "react-native-screens": "^4.26.0",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-reanimated": "^3.17.0",
    "react-native-keychain": "^10.0.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-udp": "^4.1.7",
    "react-native-network-info": "^5.2.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-fs": "^2.20.0",
    "react-native-sound": "^0.13.0",
    "@react-native-voice/voice": "^3.2.4",
    "zustand": "^5.0.0",
    "@tanstack/react-query": "^5.75.0",
    "@react-native-async-storage/async-storage": "^3.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "~5.8.2",
    "jest": "^29.7.0",
    "@react-native/babel-preset": "^0.86.0",
    "@react-native/metro-config": "^0.86.0",
    "@react-native/typescript-config": "^0.86.0"
  }
}
